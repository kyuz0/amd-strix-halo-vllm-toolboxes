# syntax=docker/dockerfile:1
# Ubuntu 24.04 + STABLE ROCm/torch for gfx1151 (Strix Halo), pip-first (TheRock era).
# Multi-stage toolbox image with WORKING VISION and the complete matched ROCm development SDK.
#
# Off the nightly treadmill: the whole gfx1151 ROCm/torch stack is STABLE release wheels from
# https://repo.amd.com/rocm/whl-multi-arch/ (TheRock multi-arch device-package layout; ROCm
# 7.14). torch brings its own matched ROCm (_rocm_sdk_core) → no system-vs-pip ABI mismatch
# (that mix segfaulted the old dev-ubuntu:7.14 + nightly-torch attempt).
#
# Vision: gfx1151 vLLM would fall back to Torch SDPA for the ViT encoder (OOMs at 256 GiB),
# so we build ROCm flash-attention + aiter Triton kernels and enable them
# (FLASH_ATTENTION_TRITON_AMD_ENABLE). aiter's C++ JIT module is
# pre-warmed at build so the dev SDK can be dropped while vision still works at runtime.
#
# BASE = 24.04 / py3.12: 26.04 ships py3.14 but vLLM's amd-quark dep has no py3.14 wheel yet.

# ============================ RDMA userspace ============================
# Ubuntu 24.04 ships rdma-core 50/libirdma rdmav34. With the current host irdma
# driver it reports RDMA_WRITE_WITH_IMM receives as plain IBV_WC_RECV, which
# RCCL rejects as an unknown completion. rdma-core 62 was validated on the same
# two-node gfx1151 setup with a clean RCCL all-reduce over RoCE.
FROM docker.io/ubuntu:24.04 AS rdma-builder
ARG RDMA_CORE_REF=v62.0
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates python3 build-essential cmake ninja-build pkg-config \
      libudev-dev libnl-3-dev libnl-route-3-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
RUN git clone --branch "${RDMA_CORE_REF}" --depth 1 \
      https://github.com/linux-rdma/rdma-core.git /opt/rdma-core && \
    cmake -S /opt/rdma-core -B /opt/rdma-core/build -GNinja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_INSTALL_LIBDIR=lib/x86_64-linux-gnu \
      -DNO_MAN_PAGES=1 \
      -DNO_PYVERBS=1 && \
    ninja -C /opt/rdma-core/build && \
    DESTDIR=/opt/rdma-core-install ninja -C /opt/rdma-core/build install

# ============================ Stage 1: builder ============================
FROM docker.io/ubuntu:24.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.12-venv python3.12-dev python3-pip \
      git aria2 ffmpeg vim nano rsync curl ca-certificates xz-utils patch pkg-config \
      protobuf-compiler libgoogle-perftools-dev libnuma-dev numactl libdrm-dev \
      libibverbs-dev ibverbs-utils rdma-core rustc cargo build-essential \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN python3.12 -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH PIP_NO_CACHE_DIR=1 PYTHONNOUSERSITE=1
RUN python -m pip install --upgrade pip wheel packaging "setuptools<80.0.0" "setuptools-rust>=1.9.0"

# STABLE gfx1151 stack from repo.amd.com — TheRock multi-arch "device package" layout:
# a GENERIC base (torch, rocm-sdk-core/-libraries/-devel) + a thin PER-ARCH device package
# (amd-torch-device-gfx1151, rocm-sdk-device-gfx1151) that overlays the gfx1151 kernels.
# ROCm 7.14 lives here; the legacy per-arch whl/gfx1151/ index is frozen at 7.13.0.
# Torch stack is PINNED to a verified, mutually-compatible combo (the 4 packages are coupled,
# and torch must match the vLLM we build) — bump deliberately. rocm-sdk-devel = build SDK.
# SINGLE SOURCE OF TRUTH = TORCH_VERSION (+ ROCM_VERSION); everything else is ALIGNED to it:
#   - amd-torch-device-gfx1151 and torchaudio share torch's version exactly
#   - torchvision tracks torch as 0.(minor+15)  (torch 2.N -> torchvision 0.(N+15); 2.11 -> 0.26)
# (pip left to itself picks the NEWEST torchvision, which is built for a newer torch — so we
# derive it rather than let it float.) A torch bump needs only these two ARGs.
ARG ROCM_WHL=https://repo.amd.com/rocm/whl-multi-arch/
ARG TORCH_VERSION=2.11.0
ARG ROCM_VERSION=7.14.0
ARG AITER_REF=v0.1.19
RUN set -e; \
    TV_MINOR=$(( $(echo "${TORCH_VERSION}" | cut -d. -f2) + 15 )); \
    TORCHVISION="0.${TV_MINOR}.0+rocm${ROCM_VERSION}"; \
    echo "aligned to torch ${TORCH_VERSION}+rocm${ROCM_VERSION} -> torchvision=${TORCHVISION}, torchaudio=${TORCH_VERSION}+rocm${ROCM_VERSION}"; \
    python -m pip install --index-url ${ROCM_WHL} --extra-index-url https://pypi.org/simple \
      "torch==${TORCH_VERSION}+rocm${ROCM_VERSION}" \
      "amd-torch-device-gfx1151==${TORCH_VERSION}+rocm${ROCM_VERSION}" \
      "rocm-sdk-devel==${ROCM_VERSION}" "rocm-sdk-device-gfx1151==${ROCM_VERSION}" \
      "torchvision==${TORCHVISION}" \
      "torchaudio==${TORCH_VERSION}+rocm${ROCM_VERSION}"
RUN python -m pip install --upgrade cmake ninja numpy "setuptools-scm>=8" \
      "setuptools<80.0.0" scikit-build-core pybind11 numba scipy einops

# amdsmi ships in the rocm-sdk but isn't importable — install + patch APU VRAM-carveout bug.
RUN ROOT=$(rocm-sdk path --root) && python -m pip install "${ROOT}/share/amd_smi"
COPY scripts/patch_amdsmi.py /opt/patch_amdsmi.py
RUN python /opt/patch_amdsmi.py

# --- VISION: ROCm flash-attention + aiter + composable_kernel (Triton ViT kernels) ---
# Built against the pip rocm-sdk for gfx1151 so the ViT uses Flash Attention, not SDPA.
COPY scripts/patch_aiter_headers.py /opt/patch_aiter_headers.py
RUN set -e; ROOT=$(rocm-sdk path --root); \
    export ROCM_PATH=$ROOT HIP_PATH=$ROOT \
      PATH=$ROOT/bin:$ROOT/lib/llvm/bin:$PATH \
      CC=$ROOT/lib/llvm/bin/amdclang CXX=$ROOT/lib/llvm/bin/amdclang++ \
      HIP_DEVICE_LIB_PATH=$ROOT/lib/llvm/amdgcn/bitcode \
      CMAKE_PREFIX_PATH=$ROOT/lib/cmake:$ROOT \
      LD_LIBRARY_PATH=$ROOT/lib:$ROOT/lib/llvm/lib \
      PYTORCH_ROCM_ARCH=gfx1151 GPU_ARCHS=gfx1151 AMDGPU_TARGETS=gfx1151 \
      AITER_USE_SYSTEM_TRITON=1; \
    cd /opt && git clone https://github.com/ROCm/flash-attention.git && \
    cd flash-attention && git checkout main_perf && \
    git submodule update --init third_party/aiter && \
    cd third_party/aiter && \
    git fetch --tags origin && git checkout --detach "${AITER_REF}" && \
    git submodule update --init 3rdparty/composable_kernel && \
    export CK_DIR="$(pwd)/3rdparty/composable_kernel" && \
    python -m pip wheel --no-build-isolation --no-deps -w /tmp/aiter_dist -v . && \
    python -m pip install --force-reinstall --no-deps /tmp/aiter_dist/amd_aiter*.whl && \
    python /opt/patch_aiter_headers.py && \
    cd /opt/flash-attention && \
    python -c "import re; f=open('setup.py'); t=f.read(); f.close(); t=re.sub(r'subprocess\.run\([\s\S]*?third_party/aiter[\s\S]*?check=True,\s*\)', 'pass # patched', t); open('setup.py','w').write(t)" && \
    pip install --no-build-isolation --no-deps . && \
    cd /opt && rm -rf /opt/flash-attention /tmp/aiter_dist

# Build vLLM from source against the pip rocm-sdk (matched to torch → no ABI mix).
ARG VLLM_REF=eb28452b1
ARG MAX_JOBS=4
ENV MAX_JOBS=${MAX_JOBS} PYTORCH_ROCM_ARCH=gfx1151 VLLM_TARGET_DEVICE=rocm \
    HIP_FORCE_DEV_KERNARG=1 MIOPEN_FIND_MODE=FAST
WORKDIR /opt
RUN git clone https://github.com/vllm-project/vllm.git /opt/vllm && \
    cd /opt/vllm && \
    if [ -n "$VLLM_REF" ]; then git checkout "$VLLM_REF"; fi && \
    python -c 'from setuptools_scm import get_version; print(get_version())' \
      > /tmp/vllm-upstream-version
WORKDIR /opt/vllm
COPY scripts/patch_strix.py /opt/vllm/patch_strix.py
RUN python /opt/vllm/patch_strix.py
RUN ROOT=$(rocm-sdk path --root) && \
    UPSTREAM_VERSION=$(cat /tmp/vllm-upstream-version) && \
    case "$UPSTREAM_VERSION" in \
      *+*) VLLM_BUILD_VERSION="${UPSTREAM_VERSION}.strix" ;; \
      *)   VLLM_BUILD_VERSION="${UPSTREAM_VERSION}+strix" ;; \
    esac && \
    echo "Building patched vLLM ${VLLM_BUILD_VERSION} from upstream ${UPSTREAM_VERSION}" && \
    export ROCM_PATH=$ROOT HIP_PATH=$ROOT \
      PATH=$ROOT/bin:$ROOT/lib/llvm/bin:$PATH \
      CC=$ROOT/lib/llvm/bin/amdclang CXX=$ROOT/lib/llvm/bin/amdclang++ \
      HIP_DEVICE_LIB_PATH=$ROOT/lib/llvm/amdgcn/bitcode \
      CMAKE_PREFIX_PATH=$ROOT/lib/cmake:$ROOT \
      LD_LIBRARY_PATH=$ROOT/lib:$ROOT/lib/llvm/lib && \
    export CMAKE_ARGS="-DROCM_PATH=$ROOT -DHIP_PATH=$ROOT -DAMDGPU_TARGETS=gfx1151 -DHIP_ARCHITECTURES=gfx1151" && \
    VLLM_VERSION_OVERRIDE="$VLLM_BUILD_VERSION" \
      python -m pip wheel --no-build-isolation --no-deps -w /tmp/dist -v . && \
    python -m pip freeze \
      | grep -E '^(amd-torch-device-gfx1151|torch|torchaudio|torchvision|triton)==' \
      > /tmp/rocm-stack.constraints && \
    TORCH_BEFORE=$(python -c 'import torch; print(torch.__version__)') && \
    TRITON_BEFORE=$(python -c 'import triton; print(triton.__version__)') && \
    python -m pip install -c /tmp/rocm-stack.constraints -r requirements/rocm.txt && \
    python -m pip install --no-deps /tmp/dist/*.whl && \
    test "$(python -c 'import importlib.metadata as m; print(m.version("vllm"))')" = "$VLLM_BUILD_VERSION" && \
    test "$(python -c 'import torch; print(torch.__version__)')" = "$TORCH_BEFORE" && \
    test "$(python -c 'import triton; print(triton.__version__)')" = "$TRITON_BEFORE" && \
    rm -rf /tmp/dist /tmp/rocm-stack.constraints
RUN python -m pip install ray


# AITER v0.1.19 detects the native GPU while importing and therefore cannot be imported on
# GitHub's GPU-less image builder. Verify the package is installed without executing it;
# model-specific modules, including DeepSeek-V4 MHC, JIT-compile on the target gfx1151 host.
RUN python -c "import importlib.util; assert importlib.util.find_spec('aiter'); print('aiter package installed OK')"
RUN CORE=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_core && \
    ln -sf libamd_smi.so.26 "$CORE/lib/libamd_smi.so" && \
    rm -rf /opt/vllm /root/.cache/pip

# ============================ Stage 2: runtime ============================
FROM docker.io/ubuntu:24.04 AS runtime
ENV DEBIAN_FRONTEND=noninteractive

# Toolbx inspects this label before treating a non-Fedora image as a toolbox image.
LABEL com.github.containers.toolbox="true" \
      usage="This image is meant to be used with the toolbox command" \
      summary="Ubuntu stable-ROCm vLLM toolbox for gfx1151"

# gcc/g++/make + python3.12-dev: Triton and AITER JIT-compile runtime kernels.
# git: aiter/flash_attn call git for version detection at import.
# sudo: toolbx/distrobox run their in-container user setup through it.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.12 python3.12-dev gcc g++ make git vim ca-certificates curl sudo libcap2-bin libnss-myhostname \
      libatomic1 libnuma1 libgomp1 libelf1 libdrm2 libdrm-amdgpu1 libtinfo6 zlib1g libssl3 \
      libgoogle-perftools4 libibverbs1 librdmacm1 dialog openssh-client iproute2 procps \
      numactl ibverbs-utils rdma-core perftest infiniband-diags iputils-ping iperf3 pciutils rsync \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Overlay the tested current verbs/provider stack on Ubuntu's old v50 packages.
# Keeping the distro packages installed supplies the runtime utilities and loader
# integration; libibverbs v62 selects the matching new libirdma provider ABI.
COPY --from=rdma-builder /opt/rdma-core-install/ /
RUN ldconfig && \
    test -f /usr/lib/x86_64-linux-gnu/libibverbs/libirdma-rdmav59.so

# Container-workflow compatibility (toolbx / distrobox / plain `podman run --group-add ...`).
#  * Ubuntu 24.04 reserves UID 1000 for its stock `ubuntu` user. Toolbx creates the host user
#    inside the container with the host UID, so leaving that account in place makes the first
#    `toolbox enter` fail with "UID 1000 is not unique". Remove it, then prove during the image
#    build that a Toolbx-style UID 1000 user can actually be created. The temporary test account
#    is removed again so UID 1000 remains free in the published image.
#  * machine-id / nss-myhostname: match the established Ubuntu Toolbx images in this project
#    family so systemd/DBus and hostname resolution can be initialized by Toolbx at runtime.
#    Resolve the container hostname before DNS to avoid a multi-second delay on every sudo.
#  * sudoers: Toolbx creates the host user without a usable container password, so members of
#    the Ubuntu sudo group need the same passwordless sudo behaviour as a standard Toolbx.
#  * render group: podman resolves `--group-add render` against the CONTAINER's /etc/group and
#    ABORTS the start if the name is missing ("unable to find group render: no matching entries
#    in group file"). Ubuntu ships video(44) and rdma(101) but no render, so every documented
#    toolbox/distrobox/podman command in the README failed to start at all on this image.
#    gid 105 matches the Fedora image for parity; -f keeps it idempotent (and transparently
#    picks a free gid if 105 is ever taken).
#    NOTE: under ROOTLESS podman these container gids never map to host gids, so --group-add
#    video/render alone does NOT grant /dev/kfd access — `--group-add keep-groups` is what
#    does (toolbx/distrobox inject it automatically). This only removes the hard failure.
#  * libdrm_amdgpu.so: amdsmi dlopen()s the UNVERSIONED soname, which ships only in libdrm-dev.
#    Without the symlink `rocm-smi` (the README's own verification step) prints "get_name,
#    Failed to load a library" and no GPU name, even though the GPU is perfectly usable.
RUN (userdel -r ubuntu 2>/dev/null || true) \
 && if getent passwd 1000 >/dev/null; then \
      echo "ERROR: UID 1000 must be free for Toolbx user creation" >&2; \
      getent passwd 1000 >&2; \
      exit 1; \
    fi \
 && install -d -m 1777 /opt/triton_cache \
 && rm -f /etc/machine-id && touch /etc/machine-id \
 && sed -Ei 's/^hosts:.*/hosts:          files myhostname dns/' /etc/nsswitch.conf \
 && getent hosts "$(hostname)" >/dev/null \
 && printf '%s\n' '%sudo ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/toolbox \
 && chmod 0440 /etc/sudoers.d/toolbox \
 && visudo -cf /etc/sudoers.d/toolbox \
 && useradd --uid 1000 --groups sudo --no-create-home toolbox-build-test \
 && test "$(id -u toolbox-build-test)" = "1000" \
 && su -s /bin/sh toolbox-build-test -c 'touch /opt/triton_cache/.toolbox-write-test' \
 && su -s /bin/sh toolbox-build-test -c 'sudo -n true' \
 && rm /opt/triton_cache/.toolbox-write-test \
 && userdel toolbox-build-test \
 && groupadd -f -g 105 render \
 && ln -sf libdrm_amdgpu.so.1 /usr/lib/x86_64-linux-gnu/libdrm_amdgpu.so

COPY --from=builder /opt/venv /opt/venv

# Preserve the user-facing toolbox contract from the original image. These are repo assets,
# not part of the vLLM wheel, so copying only /opt/venv produces an image with no start-vllm,
# model catalogue, benchmark commands, cluster manager, or login environment.
COPY scripts/01-rocm-env-for-triton.sh /etc/profile.d/01-rocm-env-for-triton.sh
COPY scripts/99-toolbox-banner.sh /etc/profile.d/99-toolbox-banner.sh
COPY scripts/zz-venv-last.sh /etc/profile.d/zz-venv-last.sh
COPY scripts/start_vllm.py /opt/start-vllm
COPY scripts/start_vllm_cluster.py /opt/start-vllm-cluster
COPY scripts/measure_bandwidth.sh /opt/measure_bandwidth.sh
COPY scripts/cluster_manager.py /opt/cluster_manager.py
COPY scripts/models.py /opt/models.py
COPY benchmarks/max_context_results.json /opt/max_context_results.json
COPY benchmarks/bench_utils.py /opt/bench_utils.py
COPY benchmarks/run_vllm_bench.py /opt/run_vllm_bench.py
COPY benchmarks/vllm_cluster_bench.py /opt/vllm_cluster_bench.py
COPY benchmarks/find_max_context.py /opt/find_max_context.py
COPY rdma_cluster/compare_eth_vs_rdma.sh /opt/compare_eth_vs_rdma.sh
COPY scripts/configure_cluster.sh /opt/configure_cluster.sh

RUN chmod 0644 /etc/profile.d/*.sh /opt/max_context_results.json /opt/models.py \
 && chmod +x /opt/start-vllm /opt/start-vllm-cluster /opt/run_vllm_bench.py \
      /opt/vllm_cluster_bench.py /opt/find_max_context.py /opt/measure_bandwidth.sh \
      /opt/compare_eth_vs_rdma.sh /opt/configure_cluster.sh \
 && ln -s /opt/start-vllm /usr/local/bin/start-vllm \
 && ln -s /opt/start-vllm-cluster /usr/local/bin/start-vllm-cluster \
 && ln -s /opt/run_vllm_bench.py /usr/local/bin/run-vllm-bench \
 && ln -s /opt/vllm_cluster_bench.py /usr/local/bin/vllm-cluster-bench \
 && ln -s /opt/find_max_context.py /usr/local/bin/find-max-context \
 && printf 'ulimit -S -c 0\n' > /etc/profile.d/90-nocoredump.sh \
 && chmod 0644 /etc/profile.d/90-nocoredump.sh

# Fail-fast: the ViT flash-attn detection MUST reference the aiter kernel location, else
# vision silently falls back to Torch SDPA and OOMs. Also guards against a stale buildcache
# layer (this cost us a broken CI image once).
RUN grep -q "aiter.ops.triton._triton_kernels.flash_attn_triton_amd" \
      /opt/venv/lib/python3.12/site-packages/vllm/platforms/rocm.py \
    || { echo "ERROR: vllm/platforms/rocm.py does not detect the aiter ViT kernels."; \
         echo "       Requires vLLM > v0.26.0."; exit 1; }

# Triton kernel cache lives here (TRITON_CACHE_DIR below). On FIRST serve of a model, Triton
# autotunes the GDN + ViT flash-attn kernels on the live GPU (a few minutes) and writes them
# here; subsequent starts reuse them. We deliberately do NOT bake a pre-warmed cache into the
# image: it is keyed to the exact torch/triton/vLLM it was warmed with, so under auto-resolve
# it would go stale and silently miss. Instead, mount a persistent host dir here to keep the
# cache across container restarts and image bumps, e.g.:
#     -v "$HOME/.cache/triton-gfx1151:/opt/triton_cache"
# Without a mount, mode 1777 lets Toolbx's dynamically created host user write the shared cache;
# the build-time user test above verifies this with the normal host UID 1000.

# Keep ROCM_PATH/HIP_PATH on rocm-sdk-core: torch and Triton use that root for runtime driver
# discovery. The complete matched rocm-sdk-devel tree remains installed, while its headers are
# exposed separately through CPLUS_INCLUDE_PATH for model-specific AITER JIT compilation.
# amdsmi resolves its unversioned symlink from _rocm_sdk_core/lib.
# FLASH_ATTENTION_TRITON_AMD_ENABLE enables the ViT flash-attn path. Paths deterministic.
# Keep the broad AITER operator toggle off by default: it also enables the unsupported gfx1151
# sampler. start-vllm enables AITER only for models such as DeepSeek V4 that use its
# sparse-indexer helper, while selecting AITER unified attention explicitly where appropriate.
ENV VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH PYTHONNOUSERSITE=1 \
    TOOLBOX_ROCM_SOURCE="repo.amd.com stable wheels" \
    ROCM_PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_core \
    HIP_PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_core \
    ROCM_DEVEL_PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_devel \
    HIP_DEVICE_LIB_PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_core/lib/llvm/amdgcn/bitcode \
    CPLUS_INCLUDE_PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_devel/include \
    LIBRARY_PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_devel/lib \
    LD_LIBRARY_PATH=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_core/lib:/opt/venv/lib/python3.12/site-packages/_rocm_sdk_libraries/lib \
    PYTORCH_ROCM_ARCH=gfx1151 GPU_ARCHS=gfx1151 FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE \
    VLLM_ROCM_USE_AITER=0 VLLM_ROCM_USE_AITER_LINEAR=0 \
    HIP_FORCE_DEV_KERNARG=1 MIOPEN_FIND_MODE=FAST \
    TRITON_CACHE_DIR=/opt/triton_cache

# The core wheel contains the versioned HIP runtime, but hipcc's --hip-link path requires the
# unversioned linker name in this exact directory. LIBRARY_PATH cannot override that absolute
# lookup, so provide the normal development symlink explicitly for AITER runtime JIT builds.
RUN if [ ! -e "$ROCM_PATH/lib/libamdhip64.so" ] && [ ! -L "$ROCM_PATH/lib/libamdhip64.so" ]; then \
      ln -s libamdhip64.so.7 "$ROCM_PATH/lib/libamdhip64.so"; \
    fi \
 && test -e "$ROCM_PATH/lib/libamdhip64.so"

# Image-contract smoke test: a successful build must contain the documented toolbox entrypoints
# and their immediate runtime dependencies. This intentionally runs before publishing.
RUN for command_name in \
      start-vllm start-vllm-cluster run-vllm-bench vllm-cluster-bench find-max-context \
      vllm ray dialog ssh ip pgrep rocm-smi rdma ibv_devices perfquery ping iperf3 lspci \
      hipcc hipconfig g++ make; do \
      command -v "$command_name" >/dev/null || { echo "ERROR: missing runtime command: $command_name" >&2; exit 1; }; \
    done \
 && test -x "$ROCM_PATH/lib/llvm/bin/amdgpu-arch" \
 && test -d "$HIP_DEVICE_LIB_PATH" \
 && test -f "$ROCM_DEVEL_PATH/include/thrust/complex.h" \
 && test -f "$ROCM_DEVEL_PATH/lib/libamdhip64.so" \
 && hipconfig --version \
 && printf '#include <hip/hip_runtime.h>\nextern "C" __global__ void hip_link_smoke() {}\n' \
      | hipcc --offload-arch=gfx1151 -fPIC -shared -x hip - -o /tmp/hipcc-link-smoke.so \
 && test -s /tmp/hipcc-link-smoke.so \
 && printf '#include <thrust/complex.h>\n' \
      | hipcc --offload-arch=gfx1151 -x hip -c - -o /tmp/hipcc-thrust-smoke.o \
 && rm -f /tmp/hipcc-link-smoke.so /tmp/hipcc-thrust-smoke.o \
 && grep -q '"gfx1151"' \
      /opt/venv/lib/python3.12/site-packages/aiter_meta/csrc/cpp_itfs/utils.py \
 && python -m py_compile \
      /opt/start-vllm /opt/start-vllm-cluster /opt/cluster_manager.py /opt/models.py \
      /opt/bench_utils.py /opt/run_vllm_bench.py /opt/vllm_cluster_bench.py /opt/find_max_context.py \
 && rm -rf /opt/__pycache__
WORKDIR /opt
CMD ["/bin/bash"]
